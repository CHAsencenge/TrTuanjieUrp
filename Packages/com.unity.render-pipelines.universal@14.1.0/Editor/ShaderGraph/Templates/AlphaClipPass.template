// Alpha Clip (Specific Material)
void GPUDrivenAlphaClip(Varyings input 
    UNITY_GDRP_MATRIX_M_PARAMETER 
    UNITY_GDRP_MATRIX_M_I_PARAMETER 
    UNITY_GDRP_INSTANCE_PARAMETER 
    UNITY_GDRP_INSTANCE_ID_PARAMETER
    , uint materialOffset = 0)
{
    // Alpha Clip do not need ddx and ddy, so here just give zero.
    PixelAttribute attribute = (PixelAttribute)0;

    SurfaceDescriptionInputs surfaceDescriptionInputs = BuildSurfaceDescriptionInputs(input UNITY_GDRP_MATRIX_M_ARGUMENT UNITY_GDRP_MATRIX_M_I_ARGUMENT UNITY_GDRP_ATTRIBUTE_ARGUMENT);
#if defined(HAVE_VFX_MODIFICATION)
    GraphProperties properties;
    ZERO_INITIALIZE(GraphProperties, properties);
    GetElementPixelProperties(surfaceDescriptionInputs, properties);
    SurfaceDescription surfaceDescription = SurfaceDescriptionFunction(surfaceDescriptionInputs UNITY_GDRP_INSTANCE_ARGUMENT UNITY_GDRP_INSTANCE_ID_ARGUMENT, properties);
#else
    SurfaceDescription surfaceDescription = SurfaceDescriptionFunction(surfaceDescriptionInputs UNITY_GDRP_INSTANCE_ARGUMENT UNITY_GDRP_INSTANCE_ID_ARGUMENT UNITY_GDRP_MATERIAL_PAGE_OFFSET_ARGUMENT);
#endif

    clip(surfaceDescription.Alpha - surfaceDescription.AlphaClipThreshold);
}

